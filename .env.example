# Database. Local default is a SQLite file; production uses Turso.
TURSO_DATABASE_URL=file:.data/tracksuit.db
TURSO_AUTH_TOKEN=

# Optional: require a setup key on the first-run owner form.
OWNER_SETUP_KEY=

# Optional Google sign-in for shoppers. Admin login stays email + password.
# Redirect URI: <your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Transactional email (Resend). Leave EMAIL_ENABLED=0 to disable.
# EMAIL_FROM must be a verified Resend sender, e.g. "UNC CODE <orders@unccode.site>".
EMAIL_ENABLED=0
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_OWNER=
EMAIL_TEST_TO=

# Meta WhatsApp Cloud API: automatic new-order alerts to the shop owner.
# Leave empty to disable; orders are still stored and the admin gets a wa.me link.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OWNER_NUMBER=
WHATSAPP_API_VERSION=v20.0

# Optional runtime license gate. Off by default: the admin works without a key.
# To require a product key for admin writes, uncomment the two values below and
# set LICENSE_DISABLED=0. The public key is safe to publish; the seller keeps the
# matching private key on the license worker.
LICENSE_DISABLED=1
# LICENSE_SERVER_URL=https://petpaw-license.sberechou.workers.dev
# LICENSE_PUBLIC_KEY={"crv":"Ed25519","kty":"OKP","x":"q2tMoDat1ek3FhSY-mBJp9FTwRQbwNSS-n8fC32REiI"}
LICENSE_PRODUCT=tracksuitsites

# Cloudflare R2 image storage (optional). When these are set, uploads go to R2;
# otherwise images stay in the database.
# R2_PUBLIC_DOMAIN is the bucket's r2.dev URL or your custom domain, no trailing slash.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=
R2_PREFIX=tracksuitsites
